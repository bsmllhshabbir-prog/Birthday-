<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Happy Birthday!</title>
  <style>
    :root {
      --primary-color: #ff85a2;    /* Soft Rose Pink */
      --secondary-color: #f7abb6;  /* Pastel Pink */
      --accent-color: #ffb6c1;     /* Light Pink */
      --bg-color: #fff0f5;         /* Lavender Blush */
      --card-bg: #ffffff;
      --text-color: #5c3d46;       /* Soft Deep Rose */
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    header {
      text-align: center;
      margin-top: 2.5rem;
      padding: 0 1rem;
    }

    h1 {
      font-size: 2.8rem;
      color: var(--primary-color);
      margin-bottom: 0.5rem;
      font-weight: 700;
    }

    p.subtitle {
      font-size: 1.1rem;
      color: #a36b77;
    }

    .card {
      background: var(--card-bg);
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(255, 133, 162, 0.15);
      padding: 2rem;
      max-width: 500px;
      width: 85%;
      margin: 1.5rem auto;
      text-align: center;
      line-height: 1.6;
      border: 1px solid #ffe4e8;
    }

    .balloon-container {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 1.5rem 0;
    }

    .balloon {
      width: 45px;
      height: 60px;
      border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
      cursor: pointer;
      position: relative;
      transition: transform 0.2s ease, opacity 0.3s ease;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 1.2rem;
      box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

    .balloon::after {
      content: "";
      position: absolute;
      bottom: -12px;
      width: 2px;
      height: 12px;
      background-color: #ffb6c1;
    }

    .balloon:hover {
      transform: scale(1.15) translateY(-5px);
    }

    .balloon.popped {
      opacity: 0;
      pointer-events: none;
    }

    /* Photo Gallery Styling */
    .gallery {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }

    .photo-frame {
      width: 130px;
      height: 130px;
      border-radius: 15px;
      background-color: #ffe4e8;
      border: 4px solid #ffffff;
      box-shadow: 0 6px 15px rgba(255, 133, 162, 0.2);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #c97a8b;
      font-size: 0.9rem;
    }

    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .btn {
      background: linear-gradient(135deg, #ff85a2, #ff6b8b);
      color: white;
      border: none;
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: bold;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(255, 133, 162, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 133, 162, 0.6);
    }

    /* Pink Confetti Canvas */
    #confetti-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 99;
    }
  </style>
</head>
<body>

  <canvas id="confetti-canvas"></canvas>

  <header>
    <h1>Happy Birthday! 💕</h1>
    <p class="subtitle">Pop the balloons to spread the love!</p>
  </header>

  <div class="balloon-container">
    <div class="balloon" style="background-color: #ff85a2;" onclick="popBalloon(this)">🎈</div>
    <div class="balloon" style="background-color: #ff9ebb;" onclick="popBalloon(this)">💖</div>
    <div class="balloon" style="background-color: #ffb6c1;" onclick="popBalloon(this)">🎈</div>
    <div class="balloon" style="background-color: #f7abb6;" onclick="popBalloon(this)">✨</div>
  </div>

  <div class="card">
    <h2 style="color: var(--primary-color);">A Special Wish for You ✨</h2>
    <p>
      Wishing you a day as sweet and wonderful as you are! 
      May your year ahead be filled with endless smiles, love, and sweet moments.
    </p>

    <!-- Optional Photo Gallery -->
    <div class="gallery">
      <div class="photo-frame">
        <!-- Replace src with your photo link -->
        <span>Photo 1 📸</span>
      </div>
      <div class="photo-frame">
        <!-- Replace src with your photo link -->
        <span>Photo 2 📸</span>
      </div>
    </div>

    <br><br>
    <button class="btn" onclick="triggerCelebration()">Celebrate! 🥳</button>
  </div>

  <script>
    function popBalloon(element) {
      element.classList.add('popped');
    }

    function triggerCelebration() {
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      let pieces = [];
      const numberOfPieces = 120;
      // Soft pink & gold celebration palette
      const colors = ['#ff85a2', '#ffb6c1', '#f7abb6', '#ffe4e8', '#ffd700'];

      for (let i = 0; i < numberOfPieces; i++) {
        pieces.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height - canvas.height,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          speed: Math.random() * 3 + 2,
          rotation: Math.random() * 360
        });
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach((p) => {
          ctx.fillStyle = p.color;
          ctx.fillRect(p.x, p.y, p.size, p.size);
          p.y += p.speed;
          if (p.y > canvas.height) p.y = -10;
        });
        requestAnimationFrame(draw);
      }
      draw();
    }
  </script>
</body>
</html>
